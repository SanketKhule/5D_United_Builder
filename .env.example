# Public canonical website origin. Do not include a path or trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# Server-only SMTP configuration.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-an-app-password
ADMIN_EMAIL=admin@example.com
COMPANY_NAME=5D United Builders

# Server-only distributed rate limiting for the contact endpoint.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-an-upstash-rest-token
